<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/snapflow_bg"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/incognito_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/incognito"
        android:textStyle="bold"
        android:visibility="gone"
        android:padding="5dp"
        android:background="?colorPrimaryContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/frame_layout"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/incognito_header" />

    <!-- Ambient Glow hidden to match clean reference screenshot -->
    <ImageView
        android:id="@+id/bottom_ambient_glow"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:src="@drawable/snapflow_bottom_ambient_glow"
        android:scaleType="fitXY"
        android:visibility="gone"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/notification_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:divider="@drawable/divider_10dp"
        android:showDividers="middle"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        android:animateLayoutChanges="true"
        app:layout_constraintBottom_toTopOf="@id/snapflow_custom_bottom_nav" />

    <!-- Sleek Custom Floating Bottom Navigation Bar (1:1 with Reference Design) -->
    <LinearLayout
        android:id="@+id/snapflow_custom_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:layout_marginHorizontal="28dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintWidth_max="340dp"
        android:background="@drawable/snapflow_floating_nav_bg"
        android:elevation="14dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 1. Download Tab (Active by default) -->
        <FrameLayout
            android:id="@+id/snapflow_nav_tab_download"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/snapflow_nav_pill_download"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:background="@drawable/snapflow_nav_pill_active"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:id="@+id/snapflow_nav_icon_download"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_snapflow_nav_download"
                    app:tint="@color/snapflow_accent_gold"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/snapflow_nav_label_download"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="serif"
                    android:text="@string/tab_download"
                    android:textColor="@color/snapflow_accent_gold"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- 2. Play Tab -->
        <FrameLayout
            android:id="@+id/snapflow_nav_tab_play"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/snapflow_nav_pill_play"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:id="@+id/snapflow_nav_icon_play"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_snapflow_nav_play"
                    app:tint="#8E8E98"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/snapflow_nav_label_play"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="serif"
                    android:text="@string/tab_play"
                    android:textColor="@color/snapflow_accent_gold"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <!-- 3. Settings Tab -->
        <FrameLayout
            android:id="@+id/snapflow_nav_tab_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/snapflow_nav_pill_settings"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:id="@+id/snapflow_nav_icon_settings"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_snapflow_nav_settings"
                    app:tint="#8E8E98"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/snapflow_nav_label_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="serif"
                    android:text="@string/tab_settings"
                    android:textColor="@color/snapflow_accent_gold"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

    <!-- Hidden BottomNavigationView to preserve all background services, badge managers, and legacy callbacks -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>